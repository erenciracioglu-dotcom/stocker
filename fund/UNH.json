{"s":"UNH","upd":"2026-11-13T20:59:53Z","profile":{"longName":"UnitedHealth Group Incorporated","shortName":"UnitedHealth Group Incorporated","displayName":"UnitedHealth","sector":"Healthcare","sectorDisp":"Healthcare","industry":"Healthcare Plans","industryDisp":"Healthcare Plans","country":"United States","city":"Eden Prairie","website":"https://www.unitedhealthgroup.com","fullTimeEmployees":390000,"longBusinessSummary":"UnitedHealth Group Incorporated operates as a health care company in the United States and internationally. It operates through four segments: Optum Health, Optum Insight, Optum Rx; and UnitedHealthcare. The Optum Health segment provides care delivery, care management, wellness and consumer engagement, and health financial services with patients, consumers, care delivery systems, providers, employers, payers, and public-sector entities. The Optum Insight segment offers software and information products, advisory consulting arrangements, and managed services outsourcing contracts to hospital systems, physicians, health plans, public entities, life sciences companies and other organizations. The Optum Rx segment provides pharmacy care services and programs, including retail network contracting, home delivery, specialty and community health pharmacy services, infusion, and purchasing and clinical capabilities, as well as develops programs in the areas of step therapy, formulary management, drug adherence, and disease and drug therapy management. The UnitedHealthcare segment offers consumer-oriented health benefit plans and services for national employers, public sector employers, mid-sized employers, small businesses, and individuals; Medicaid plans, including Temporary Assistance to Needy Families; Children's Health Insurance Programs; Dual SNPs; Long-Term Services and Supports; Aged, Blind and Disabled; and other federal, state, and community health care programs. and health care benefits products and services to state programs caring for the economically disadvantaged, medically underserved, and those without the benefit of employer-funded health care coverage. UnitedHealth Group Incorporated was founded in 1974 and is based in Eden Prairie, Minnesota.","quoteType":"EQUITY","exchange":"NYQ","fullExchangeName":"NYSE","currency":"USD","financialCurrency":"USD","firstTradeDateMilliseconds":466867800000},"stats":{"marketCap":365156073472,"enterpriseValue":416236634112,"trailingPE":23.260843,"forwardPE":17.467527,"pegRatio":1.02,"trailingPegRatio":1.0297,"priceToBook":3.722347,"priceToSalesTrailing12Months":0.81135154,"enterpriseToRevenue":0.925,"enterpriseToEbitda":14.401,"profitMargins":0.03529,"grossMargins":0.20048,"operatingMargins":0.058530003,"ebitdaMargins":0.06422,"returnOnEquity":0.15773,"returnOnAssets":0.05243,"revenueGrowth":-0.004,"earningsGrowth":0.761,"earningsQuarterlyGrowth":0.75,"totalRevenue":450059010048,"grossProfits":90226999296,"ebitda":28903000064,"netIncomeToCommon":15884000256,"operatingCashflow":26194999296,"freeCashflow":26501249024,"totalCash":28548999168,"totalCashPerShare":31.862,"totalDebt":74330996736,"debtToEquity":70.426,"currentRatio":0.739,"quickRatio":0.662,"bookValue":109.482,"revenuePerShare":498.128,"trailingEps":17.52,"forwardEps":23.33072,"epsCurrentYear":20.51936,"epsTrailingTwelveMonths":17.52,"dividendRate":9.28,"dividendYield":2.29,"payoutRatio":0.5171,"exDividendDate":1796601600,"lastDividendValue":2.32,"lastDividendDate":1789344000,"trailingAnnualDividendRate":9.06,"trailingAnnualDividendYield":0.022363193,"fiveYearAvgDividendYield":1.56,"beta":0.52,"sharesOutstanding":896022611,"floatShares":893442066,"impliedSharesOutstanding":896022611,"sharesShort":13963759,"sharesShortPriorMonth":15950438,"shortRatio":2.41,"shortPercentOfFloat":0.0174,"sharesPercentSharesOut":0.0156,"dateShortInterest":1793318400,"heldPercentInsiders":0.0025099998,"heldPercentInstitutions":0.90195,"targetMeanPrice":476.16,"targetHighPrice":531.0,"targetLowPrice":380.0,"targetMedianPrice":490.