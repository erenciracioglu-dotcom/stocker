ina mainland, Hong Kong, Taiwan, Japan, Australia, New Zealand, and rest of Asia. The company was formerly known as Apple Computer, Inc. and changed its name to Apple Inc. in January 2007. Apple Inc. was founded in 1976 and is headquartered in Cupertino, California.","quoteType":"EQUITY","exchange":"NMS","fullExchangeName":"NasdaqGS","currency":"USD","financialCurrency":"USD","firstTradeDateMilliseconds":345479400000},"stats":{"marketCap":5001541320704,"enterpriseValue":5039297921024,"trailingPE":38.326283,"forwardPE":32.321957,"pegRatio":2.8,"trailingPegRatio":2.8035,"priceToBook":44.62207,"priceToSalesTrailing12Months":10.445251,"enterpriseToRevenue":10.524,"enterpriseToEbitda":29.386,"profitMargins":0.27604,"grossMargins":0.48786,"operatingMargins":0.31125,"ebitdaMargins":0.35813,"returnOnEquity":1.42257,"returnOnAssets":0.25868,"revenueGrowth":0.117,"earningsGrowth":0.141,"earningsQuarterlyGrowth":0.118,"totalRevenue":478833999872,"grossProfits":233602007040,"ebitda":171486003200,"netIncomeToCommon":132175003648,"operatingCashflow":145096998912,"freeCashflow":105658376192,"totalCash":56722001920,"totalCashPerShare":3.903,"totalDebt":94478999552,"debtToEquity":84.286,"currentRatio":1.023,"quickRatio":0.827,"bookValue":7.713,"revenuePerShare":32.658,"trailingEps":8.98,"forwardEps":10.64818,"epsCurrentYear":9.44849,"epsTrailingTwelveMonths":8.98,"dividendRate":1.08,"dividendYield":0.31,"payoutRatio":0.118,"exDividendDate":1794441600,"lastDividendValue":0.27,"lastDividendDate":1786320000,"trailingAnnualDividendRate":1.06,"trailingAnnualDividendYield":0.003032817,"fiveYearAvgDividendYield":0.47,"beta":1.089,"sharesOutstanding":14532182000,"floatShares":14507186647,"impliedSharesOutstanding":14532182000,"sharesShort":131591865,"sharesShortPriorMonth":128753092,"shortRatio":3.48,"shortPercentOfFloat":0.0091,"sharesPercentSharesOut":0.0091,"dateShortInterest":1792022400,"heldPercentInsiders":0.016549999,"heldPercentInstitutions":0.66571,"targetMeanPrice":333.28052,"targ