ina mainland, Hong Kong, Taiwan, Japan, Australia, New Zealand, and rest of Asia. The company was formerly known as Apple Computer, Inc. and changed its name to Apple Inc. in January 2007. Apple Inc. was founded in 1976 and is headquartered in Cupertino, California.","quoteType":"EQUITY","exchange":"NMS","fullExchangeName":"NasdaqGS","currency":"USD","financialCurrency":"USD","firstTradeDateMilliseconds":345479400000},"stats":{"marketCap":5167353167872,"enterpriseValue":5205110292480,"trailingPE":39.59688,"forwardPE":33.631805,"pegRatio":3.94,"trailingPegRatio":2.8397,"priceToBook":46.101387,"priceToSalesTrailing12Months":10.791533,"enterpriseToRevenue":10.87,"enterpriseToEbitda":30.353,"profitMargins":0.27604,"grossMargins":0.48786,"operatingMargins":0.33009997,"ebitdaMargins":0.35813,"returnOnEquity":1.42257,"returnOnAssets":0.25868,"revenueGrowth":0.117,"earningsGrowth":0.141,"earningsQuarterlyGrowth":0.118,"totalRevenue":478833999872,"grossProfits":233602007040,"ebitda":171486003200,"netIncomeToCommon":132175003648,"operatingCashflow":145096998912,"freeCashflow":105658376192,"totalCash":56722001920,"totalCashPerShare":3.903,"totalDebt":94478999552,"debtToEquity":84.286,"currentRatio":1.023,"quickRatio":0.827,"bookValue":7.713,"revenuePerShare":32.658,"trailingEps":8.98,"forwardEps":10.57273,"epsCurrentYear":9.41941,"epsTrailingTwelveMonths":8.98,"dividendRate":1.08,"dividendYield":0.3,"payoutRatio":0.118,"exDividendDate":1794441600,"lastDividendValue":0.27,"lastDividendDate":1794441600,"trailingAnnualDividendRate":1.06,"trailingAnnualDividendYield":0.002993758,"fiveYearAvgDividendYield":0.46,"beta":1.089,"sharesOutstanding":14532182000,"floatShares":14507477291,"impliedSharesOutstanding":14532182000,"sharesShort":143471087,"sharesShortPriorMonth":131591865,"shortRatio":3.04,"shortPercentOfFloat":0.0099,"sharesPercentSharesOut":0.0099,"dateShortInterest":1794528000,"heldPercentInsiders":0.01686,"heldPercentInstitutions":0.66494006,"targetMeanPrice":345.6313,"targ