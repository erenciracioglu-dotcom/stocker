{"s":"ABBV","upd":"2026-11-27T09:40:00Z","profile":{"longName":"AbbVie Inc.","shortName":"AbbVie Inc.","displayName":"AbbVie","sector":"Healthcare","sectorDisp":"Healthcare","industry":"Drug Manufacturers - General","industryDisp":"Drug Manufacturers - General","country":"United States","city":"North Chicago","website":"https://www.abbvie.com","fullTimeEmployees":57000,"longBusinessSummary":"AbbVie Inc., a research-based biopharmaceutical company, engages in the research and development, manufacturing, commercializing, and sale of medicines and therapies worldwide. The company offers Skyrizi to treat autoimmune diseases; Rinvoq to treat inflammatory diseases; Imbruvica for the treatment of adult patients with blood cancers; Venclexta to treat blood cancers; Elahere to treat various cancer; and Epkinly to treat lymphoma; and Emrelis for the treatment of lung cancer. It also provides facial injectables, plastics and regenerative medicine, body contouring, and skincare products; botox Cosmetic for the treatment of glabellar lines, crow's feet, forehead lines, and platysma bands; Juvederm Collection to treat volume loss in the temples, undereye, cheeks, chin, lips and lower face; Vraylar to treat schizophrenia, bipolar disorder, and depressive disorder; Duodopa to treat Parkinson's disease; Ubrelvy to treat migraine; Qulipta for episodic and chronic migraine; and Vyalev for the treatment of motor fluctuations, as well as Botox Therapeutic to treat chronic migraine, overactive bladder, spasticity, cervical dystonia, and other conditions. In addition, the company offers Ozurdex for visual impairment; Lumigan/Ganfort and Alphagan/Combigan for the reduction of elevated intraocular pressure in patients with open angle glaucoma or ocular hypertension; and other eye care products, including Refresh/Optive, Xen, Durysta, and Restasis. Further, it provides Mavyret to treat chronic hepatitis C virus genotype 1-6 infection; Creon, a pancreatic enzyme therapy; and Linzess/Constella to treat irritable bowel syndrome with constipation and chronic idiopathic constipation. The company was incorporated in 2012 and is headquartered in North Chicago, Illinois.","quoteType":"EQUITY","exchange":"NYQ","fullExchangeName":"NYSE","currency":"USD","financialCurrency":"USD","firstTradeDateMilliseconds":1357137000000},"stats":{"marketCap":520527642624,"enterpriseValue":591115649024,"trailingPE":50.59794,"forwardPE":18.157883,"pegRatio":7.03,"trailingPegRatio":0.5759,"priceToBook":-113.56731,"priceToSalesTrailing12Months":7.88511,"enterpriseToRevenue":8.954,"enterpriseToEbitda":18.559,"profitMargins":0.15666,"grossMargins":0.73724,"operatingMargins":0.36635,"ebitdaMargins":0.48249,"returnOnAssets":0.10736,"revenueGrowth":0.103,"earningsGrowth":22.821,"earningsQuarterlyGrowth":21.677,"totalRevenue":66013999104,"grossProfits":48668000256,"ebitda":31850999808,"netIncomeToCommon":10302999552,"operatingCashflow":20088999936,"freeCashflow":17693124608,"totalCash":10773999616,"totalCashPerShare":6.095,"totalDebt":81317003264,"currentRatio":0.87,"quickRatio":0.563,"bookValue":-2.593,"revenuePerShare":37.317,"trailingEps":5.82,"forwardEps":16.21775,"epsCurrentYear":13.98424,"epsTrailingTwelveMonths":5.82,"dividendRate":6.92,"dividendYield":2.35,"payoutRatio":1.1735,"exDividendDate":1799971200,"lastDividendValue":1.73,"lastDividendDate":1792022400,"trailingAnnualDividendRate":6.92,"trailingAnnualDividendYield":0.023045158,"fiveYearAvgDividendYield":3.38,"beta":0.192,"sharesOutstanding":1767616306,"floatShares":1764505301,"impliedSharesOutstanding":1767616306,"sharesShort":16704999,"sharesShortPriorMonth":15582821,"shortRatio":3.12,"shortPercentOfFloat":0.0105,"sharesPercentSharesOut":0.0095,"dateShortInterest":1794528000,"heldPercentInsiders":0.00189,"heldPercentInstitutions":0.77566004,"targetMeanPrice":317.14816,"targetHighPrice":350.0,"targetLowPrice":237.0,"targetMedianPrice":322.0,"recommendationKey":"buy","recommendationMean":1.7,"numberOfAnalystOpinions":27,"ave