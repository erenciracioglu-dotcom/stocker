{"s":"LRCX","upd":"2026-11-07T07:07:34Z","profile":{"longName":"Lam Research Corporation","shortName":"Lam Research Corporation","displayName":"Lam Research","sector":"Technology","sectorDisp":"Technology","industry":"Semiconductor Equipment & Materials","industryDisp":"Semiconductor Equipment & Materials","country":"United States","city":"Fremont","website":"https://www.lamresearch.com","irWebsite":"http://investor.lamrc.com/","fullTimeEmployees":24300,"longBusinessSummary":"Lam Research Corporation designs, manufactures, markets, refurbishes, and services semiconductor processing equipment used in the fabrication of integrated circuits in the United States, China, Korea, Taiwan, Japan, Southeast Asia, and Europe. The company offers ALTUS systems to deposit conformal or selective films for tungsten or molybdenum metallization applications; SABRE electrochemical deposition products for copper interconnect transition, which support copper damascene manufacturing; Striker single-wafer atomic layer deposition products for dielectric film solutions; and VECTOR plasma-enhanced chemical vapor deposition (CVD) products. It also provides Akara, a conductor etch system designed to enhance etch precision, selectivity, and defect control; Argos, Prevos, and Selis, which are selective etch systems used in the fabrication of advanced logic and memory devices that require precise control at nanoscale dimensions; Flex for dielectric etch applications; Vantex, a dielectric etch system that provides RF technology and repeatable wafer-to-wafer performance enabled by Equipment Intelligence solutions; Kiyo for conductor etch applications; Syndion for deep silicon etch; and Versys metal products for metal etch processes. In addition, the company offers Coronus bevel clean products to enhance die yield and Da Vinci, DV-Prime, EOS, and SP series products to address various wafer cleaning applications. Further, it provides Reliant deposition, etch, and clean products; Sense.i platform products; and customer service, spares, and upgrades. Lam Research Corporation was incorporated in 1980 and is headquartered in Fremont, California.","quoteType":"EQUITY","exchange":"NMS","fullExchangeName":"NasdaqGS","currency":"USD","financialCurrency":"USD","firstTradeDateMilliseconds":452525400000},"stats":{"marketCap":250835501056,"enterpriseValue":246681894912,"trailingPE":29.871834,"forwardPE":16.380728,"pegRatio":0.81,"trailingPegRatio":0.806,"priceToBook":18.002516,"priceToSalesTrailing12Months":9.60028,"enterpriseToRevenue":9.441,"enterpriseToEbitda":24.384,"profitMargins":0.3234,"grossMargins":0.51054,"operatingMargins":0.39951,"ebitdaMargins":0.38719,"returnOnEquity":0.7012,"returnOnAssets":0.25010002,"revenueGrowth":0.544,"earningsGrowth":0.766,"earningsQuarterlyGrowth":0.755,"totalRevenue":26127935488,"grossProfits":13339282432,"ebitda":10116395008,"netIncomeToCommon":8449873920,"operatingCashflow":7576345088,"freeCashflow":4548759552,"totalCash":7437384192,"totalCashPerShare":5.954,"totalDebt":3735443968,"debtToEquity":26.857,"currentRatio":2.479,"quickRatio":1.791,"bookValue":11.134,"revenuePerShare":20.874,"trailingEps":6.71,"forwardEps":12.23633,"epsCurrentYear":9.65024,"epsTrailingTwelveMonths":6.71,"dividendRate":1.32,"dividendYield":0.66,"payoutRatio":0.16540001,"exDividendDate":1790121600,"lastDividendValue":0.33,"lastDividendDate":1790121600,"trailingAnnualDividendRate":1.11,"trailingAnnualDividendYield":0.005993521,"fiveYearAvgDividendYield":0.78,"beta":2.01,"sharesOutstanding":1251424362,"floatShares":1244211791,"impliedSharesOutstanding":1251424362,"sharesShort":28325154,"sharesShortPriorMonth":26081081,"shortRatio":3.15,"shortPercentOfFloat":0.0227,"sharesPercentSharesOut":0.0226,"dateShortInterest":1792022400,"heldPercentInsiders":0.00282,"heldPercentInstitutions":0.88845,"targetMeanPrice":364.03333,"targetHighPrice":500.0,"targetLowPrice":255.0,"targetMedianPrice":352.5,"recommendationKey":"strong_buy","recommendationMean":1.38235,"numberOfA