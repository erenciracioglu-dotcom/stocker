{"s":"ISCTR.IS","upd":"2026-11-07T07:07:28Z","profile":{"longName":"Türkiye Is Bankasi A.S.","shortName":"IS BANKASI (C)","sector":"Financial Services","sectorDisp":"Financial Services","industry":"Banks - Regional","industryDisp":"Banks - Regional","country":"Turkey","city":"Istanbul","website":"https://www.isbank.com.tr","fullTimeEmployees":25940,"longBusinessSummary":"Türkiye Is Bankasi A.S., together with its subsidiaries, provides various banking products and services to individuals and businesses in Turkey. It operates through Corporate/Commercial Banking; Retail/Private Banking; Treasury Operations and Investment Activities; Insurance and Reinsurance Activities; and Other segments. The company offers personal loans comprising land, education, overdraft, and yacht loans; car and home loans; credit and debit cards; deposit and investment products, such as term deposits, term TL, term FX, term gold, non-term deposits, gold, equities, futures and options markets, mutual funds, Eurobonds, and debt instruments; digital banking; compulsory earthquake, motor vehicle compulsory third party liability, comprehensive motor, health, personal accident, workplace, life, critical illness, credit card payment protecting, and loan payment protection insurance products; pension funds; and expat, private, and startup banking services. It also provides cash and non-cash loans; letters of guarantee and credit; agricultural banking; and foreign trade transactions, trading, and financing services. In addition, the company offers project financing, working capital and investment loans, cash management, checks and promissory notes, bill collection, payroll payments, investment accounts, tax collection, and other banking products; overdraft accounts, money transfer, and safe deposit boxes; individual retirement plans, life and non-life insurance services, and reinsurance services; securities trading, spot and forward trading, syndication, and securitization services; derivative transactions, such as forwards, swaps, futures and options; brokerage, venture capital, and real estate investment trust services; investment banking; and financial leasing, factoring, asset management, portfolio management, and payment services. Türkiye Is Bankasi A.S. was founded in 1924 and is headquartered in Istanbul, Turkey.","quoteType":"EQUITY","exchange":"IST","fullExchangeName":"Istanbul","currency":"TRY","financialCurrency":"TRY","firstTradeDateMilliseconds":1199086200000},"stats":{"marketCap":332249989120,"enterpriseValue":984744984576,"trailingPE":4.977528,"forwardPE":2.6264822,"pegRatio":0.83,"priceToBook":0.7761944,"priceToSalesTrailing12Months":0.74925274,"enterpriseToRevenue":2.221,"profitMargins":0.14474,"grossMargins":0.0,"operatingMargins":0.15383,"ebitdaMargins":0.0,"returnOnEquity":0.17778,"returnOnAssets":0.01585,"revenueGrowth":0.258,"earningsQuarterlyGrowth":-0.265,"totalRevenue":443441807360,"grossProfits":442231554048,"netIncomeToCommon":64183685120,"operatingCashflow":-358344753152,"totalCash":1372322004992,"totalCashPerShare":21.957,"totalDebt":1433026953216,"bookValue":17.122,"revenuePerShare":14.178,"trailingEps":2.67,"forwardEps":5.06,"epsCurrentYear":2.92502,"epsTrailingTwelveMonths":2.67,"dividendRate":0.54,"dividendYield":4.06,"payoutRatio":0.19860001,"exDividendDate":1775001600,"lastDividendValue":0.539521,"lastDividendDate":1775001600,"trailingAnnualDividendRate":0.0,"trailingAnnualDividendYield":0.0,"fiveYearAvgDividendYield":2.06,"sharesOutstanding":24999970000,"floatShares":20780000000,"impliedSharesOutstanding":25000000000,"heldPercentInsiders":0.70422995,"heldPercentInstitutions":0.066539995,"targetMeanPrice":18.48504,"targetHighPrice":23.19,"targetLowPrice":15.0,"targetMedianPrice":18.15,"recommendationKey":"buy","recommendationMean":1.64286,"numberOfAnalystOpinions":14,"averageAnalystRating":"1.6 - Buy","fiftyTwoWeekHigh":18.21,"fiftyTwoWeekLow":11.64,"fiftyDayAverage":12.9064,"twoHundredDayAverage":13.9461,"averageVolume":498584