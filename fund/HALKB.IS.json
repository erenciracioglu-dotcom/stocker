{"s":"HALKB.IS","upd":"2026-11-06T08:48:43Z","profile":{"longName":"Türkiye Halk Bankasi A.S.","shortName":"T. HALK BANKASI","sector":"Financial Services","sectorDisp":"Financial Services","industry":"Banks - Regional","industryDisp":"Banks - Regional","country":"Turkey","city":"Istanbul","website":"https://www.halkbank.com.tr","irWebsite":"http://www.halkbank.com.tr/channels/200.asp?id=377","fullTimeEmployees":22000,"longBusinessSummary":"Türkiye Halk Bankasi A.S., together with its subsidiaries, offers various banking products and services. The company provides deposit products, including e-deposits, deposit accounts with investment funds, child accounts, accumulated deposit accounts, producing deposit accounts, current TL accounts, time deposit TL/FX accounts, current FX accounts, gold deposit accounts, and safety deposit boxes. It also offers personal, auto, mortgage, and overdraft loans; letter of credit, commercial, and cash and non-cash loans; medium and long-term, and investment and project loans; loans from international financial institutions; and foreign trade loans. In addition, the company provides various cards and payment services; insurance products; derivative products; and investment products comprising investment funds, Fon24, domestic government bonds, bank bills and bonds, eurobonds, repos, forwards, options, swaps, and secured options, as well as cash management services. Further, it offers Internet, mobile, and SMS banking services. Additionally, the company is involved in investment in capital market instruments based on real estate, real estate projects, and rights based on real estate; financial leasing; factoring; financing; savings; financing and asset management; and capital markets activities. Türkiye Halk Bankasi A.S. operates domestic and foreign branches in Cyprus and Bahrain and representative offices in England and Iran. Türkiye Halk Bankasi A.S. was founded in 1933 and is headquartered in Istanbul, Turkey. Türkiye Halk Bankasi A.S. operates as a subsidiary of Turkey Wealth Fund.","quoteType":"EQUITY","exchange":"IST","fullExchangeName":"Istanbul","currency":"TRY","financialCurrency":"TRY","firstTradeDateMilliseconds":1178865000000},"stats":{"marketCap":287678529536,"enterpriseValue":-227137404928,"trailingPE":8.878049,"forwardPE":8.977578,"pegRatio":0.32,"priceToBook":1.2258143,"priceToSalesTrailing12Months":1.5587991,"enterpriseToRevenue":-1.231,"profitMargins":0.17448999,"grossMargins":0.0,"operatingMargins":0.12191,"ebitdaMargins":0.0,"returnOnEquity":0.15313,"returnOnAssets":0.00765,"revenueGrowth":0.461,"earningsGrowth":0.315,"earningsQuarterlyGrowth":0.315,"totalRevenue":184551374848,"grossProfits":183259512832,"netIncomeToCommon":32201695232,"operatingCashflow":-517052432384,"totalCash":1231960014848,"totalCashPerShare":171.468,"totalDebt":703001985024,"bookValue":32.664,"revenuePerShare":25.686,"trailingEps":4.51,"forwardEps":4.46,"epsCurrentYear":6.25166,"epsTrailingTwelveMonths":4.51,"dividendYield":0.0,"payoutRatio":0.0,"exDividendDate":1534291200,"lastDividendValue":0.149018,"lastDividendDate":1534291200,"trailingAnnualDividendRate":0.0,"trailingAnnualDividendYield":0.0,"fiveYearAvgDividendYield":2.03,"beta":0.768,"sharesOutstanding":7184778041,"floatShares":610777981,"impliedSharesOutstanding":7184778041,"heldPercentInsiders":0.91493,"heldPercentInstitutions":0.00428,"targetMeanPrice":41.79973,"targetHighPrice":54.3184,"targetLowPrice":22.7,"targetMedianPrice":43.65,"recommendationKey":"hold","recommendationMean":3.14286,"numberOfAnalystOpinions":6,"averageAnalystRating":"3.1 - Hold","fiftyTwoWeekHigh":54.35,"fiftyTwoWeekLow":25.74,"fiftyDayAverage":44.9152,"twoHundredDayAverage":42.28645,"averageVolume":38354695,"averageVolume10days":19760912,"averageDailyVolume3Month":38354695,"earningsTimestamp":1786114800,"earningsTimestampStart":1793977200,"earningsTimestampEnd":1793977200,"isEarningsDateEstimate":true,"lastSplitFactor":"1:1000","lastSplitDate":1104710400},"fin":{"y":{"d":[