{"s":"SMCI","upd":"2026-11-06T08:50:53Z","profile":{"longName":"Super Micro Computer, Inc.","shortName":"Super Micro Computer, Inc.","displayName":"Super Micro Computer","sector":"Technology","sectorDisp":"Technology","industry":"Computer Hardware","industryDisp":"Computer Hardware","country":"United States","city":"San Jose","website":"https://www.supermicro.com","irWebsite":"http://ir.supermicro.com/","fullTimeEmployees":7000,"longBusinessSummary":"Super Micro Computer, Inc., together with its subsidiaries, develops and sells server and storage solutions based on modular and open-standard architecture in the United States, Asia, Europe, and internationally. The company offers liquid and air-cooled AI servers for training and inferencing with integrated graphics processing units (GPUs) or PCIe based architectures; SuperBlade, MicroBlade, FlexTwin, GrandTwin, and BigTwin blade and multi-node systems; SuperStorage systems; Hyper, CloudDC, and WIO and rackmount systems; embedded (5G/IoT/Edge) systems; and MicroCloud server systems. It also provides workstations and networking devices; and modular server subsystems and accessories, including server boards, chassis, power supplies, and other accessories. In addition, the company offers remote system management solutions, such as Server Management suite comprising Supermicro Server Manager, Supermicro Power Management software, Supermicro Update Manager, SuperCloud Composer, SuperCloud Director, and SuperDoctor 5. Further, the company identifies service requirements; creates and executes project plans; conducts verification testing; offers training; and provides technical documentation. Additionally, it provides rack level services from design to deployment for full rack and cluster level deployments of AI and HPC datacenters; help desk services and on-site product support; and warranties, maintenance, and technical support services. The company serves enterprise data centers, cloud computing, artificial intelligence, 5G, and edge computing markets through direct and indirect sales force, distributors, value-added resellers, system integrators, and original equipment manufacturers. Super Micro Computer, Inc. has a strategic alliance with NetApp, Inc. Super Micro Computer, Inc. was incorporated in 1993 and is headquartered in San Jose, California.","quoteType":"EQUITY","exchange":"NMS","fullExchangeName":"NasdaqGS","currency":"USD","financialCurrency":"USD","firstTradeDateMilliseconds":1175175000000},"stats":{"marketCap":17517322240,"enterpriseValue":24385091584,"trailingPE":5.7130804,"forwardPE":4.4839783,"pegRatio":0.91,"priceToBook":1.5049461,"priceToSalesTrailing12Months":0.32444826,"enterpriseToRevenue":0.452,"enterpriseToEbitda":5.178,"profitMargins":0.067719996,"grossMargins":0.1167,"operatingMargins":0.1035,"ebitdaMargins":0.08722,"returnOnEquity":0.32368,"returnOnAssets":0.116059996,"revenueGrowth":2.975,"earningsGrowth":5.813,"earningsQuarterlyGrowth":8.473,"totalRevenue":53991112704,"grossProfits":6300920832,"ebitda":4709094912,"netIncomeToCommon":3294405120,"operatingCashflow":-6326384128,"freeCashflow":-8065135104,"totalCash":6897497088,"totalCashPerShare":10.48,"totalDebt":9234062336,"debtToEquity":57.466,"currentRatio":3.024,"quickRatio":1.501,"bookValue":17.994,"revenuePerShare":87.445,"trailingEps":4.74,"forwardEps":6.03928,"epsCurrentYear":4.93392,"epsTrailingTwelveMonths":4.74,"dividendYield":0.0,"payoutRatio":0.0,"trailingAnnualDividendRate":0.0,"trailingAnnualDividendYield":0.0,"beta":2.181,"sharesOutstanding":646873027,"floatShares":558711184,"impliedSharesOutstanding":646873027,"sharesShort":80104936,"sharesShortPriorMonth":95156102,"shortRatio":2.28,"shortPercentOfFloat":0.1359,"sharesPercentSharesOut":0.12189999,"dateShortInterest":1792022400,"heldPercentInsiders":0.1266,"heldPercentInstitutions":0.69635004,"targetMeanPrice":43.26667,"targetHighPrice":60.0,"targetLowPrice":15.0,"targetMedianPrice":45.0,"recommendationKey":"hold","recommendationMean":2.94444,