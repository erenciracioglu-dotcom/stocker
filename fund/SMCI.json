{"s":"SMCI","upd":"2026-11-13T07:55:28Z","profile":{"longName":"Super Micro Computer, Inc.","shortName":"Super Micro Computer, Inc.","displayName":"Super Micro Computer","sector":"Technology","sectorDisp":"Technology","industry":"Computer Hardware","industryDisp":"Computer Hardware","country":"United States","city":"San Jose","website":"https://www.supermicro.com","irWebsite":"http://ir.supermicro.com/","fullTimeEmployees":7000,"longBusinessSummary":"Super Micro Computer, Inc., together with its subsidiaries, develops and sells server and storage solutions based on modular and open-standard architecture in the United States, Asia, Europe, and internationally. The company offers liquid and air-cooled AI servers for training and inferencing with integrated graphics processing units (GPUs) or PCIe based architectures; SuperBlade, MicroBlade, FlexTwin, GrandTwin, and BigTwin blade and multi-node systems; SuperStorage systems; Hyper, CloudDC, and WIO and rackmount systems; embedded (5G/IoT/Edge) systems; and MicroCloud server systems. It also provides workstations and networking devices; and modular server subsystems and accessories, including server boards, chassis, power supplies, and other accessories. In addition, the company offers remote system management solutions, such as Server Management suite comprising Supermicro Server Manager, Supermicro Power Management software, Supermicro Update Manager, SuperCloud Composer, SuperCloud Director, and SuperDoctor 5. Further, the company identifies service requirements; creates and executes project plans; conducts verification testing; offers training; and provides technical documentation. Additionally, it provides rack level services from design to deployment for full rack and cluster level deployments of AI and HPC datacenters; help desk services and on-site product support; and warranties, maintenance, and technical support services. The company serves enterprise data centers, cloud computing, artificial intelligence, 5G, and edge computing markets through direct and indirect sales force, distributors, value-added resellers, system integrators, and original equipment manufacturers. Super Micro Computer, Inc. has a strategic alliance with NetApp, Inc. Super Micro Computer, Inc. was incorporated in 1993 and is headquartered in San Jose, California.","quoteType":"EQUITY","exchange":"NMS","fullExchangeName":"NasdaqGS","currency":"USD","financialCurrency":"USD","firstTradeDateMilliseconds":1175175000000},"stats":{"marketCap":17792546816,"enterpriseValue":24284919808,"trailingPE":5.694093,"forwardPE":3.8862157,"pegRatio":0.91,"priceToBook":1.5023657,"priceToSalesTrailing12Months":0.32954586,"enterpriseToRevenue":0.45,"enterpriseToEbitda":5.336,"profitMargins":0.067719996,"grossMargins":0.11378,"operatingMargins":0.08326,"ebitdaMargins":0.084300004,"returnOnEquity":0.32368,"returnOnAssets":0.11212,"revenueGrowth":2.975,"earningsGrowth":5.813,"earningsQuarterlyGrowth":8.473,"totalRevenue":53991112704,"grossProfits":6143321088,"ebitda":4551495168,"netIncomeToCommon":3294405120,"operatingCashflow":-6326384128,"freeCashflow":-8191506944,"totalCash":6912595968,"totalCashPerShare":10.486,"totalDebt":9178550272,"debtToEquity":57.12,"currentRatio":3.024,"quickRatio":1.526,"bookValue":17.965,"revenuePerShare":87.445,"trailingEps":4.74,"forwardEps":6.94506,"epsCurrentYear":6.5223,"epsTrailingTwelveMonths":4.74,"dividendYield":0.0,"payoutRatio":0.0,"trailingAnnualDividendRate":0.0,"trailingAnnualDividendYield":0.0,"beta":2.181,"sharesOutstanding":659227367,"floatShares":559987279,"impliedSharesOutstanding":659227367,"sharesShort":75016977,"sharesShortPriorMonth":87363140,"shortRatio":2.15,"shortPercentOfFloat":0.1268,"sharesPercentSharesOut":0.113800004,"dateShortInterest":1793318400,"heldPercentInsiders":0.12617,"heldPercentInstitutions":0.66740996,"targetMeanPrice":43.6,"targetHighPrice":65.0,"targetLowPrice":18.0,"targetMedianPrice":45.0,"recommendationKey":"hold","recommendationMean":2.94444,"nu