, and consulting and advanced customer services. It markets and sells its cloud, license, hardware, support, and services offerings directly to businesses in various industries, government agencies, and educational institutions, as well as through indirect channels. Oracle Corporation has a strategic alliance with Metron, Inc. The company was founded in 1977 and is headquartered in Austin, Texas.","quoteType":"EQUITY","exchange":"NYQ","fullExchangeName":"NYSE","currency":"USD","financialCurrency":"USD","firstTradeDateMilliseconds":511021800000},"stats":{"marketCap":334000062464,"enterpriseValue":461376847872,"trailingPE":16.791534,"forwardPE":9.687299,"pegRatio":2.83,"trailingPegRatio":0.5498,"priceToBook":5.240168,"priceToSalesTrailing12Months":4.6533666,"enterpriseToRevenue":6.428,"enterpriseToEbitda":13.399,"profitMargins":0.2636,"grossMargins":0.63957,"operatingMargins":0.34272,"ebitdaMargins":0.47973,"returnOnEquity":0.41192,"returnOnAssets":0.06357,"revenueGrowth":0.296,"earningsGrowth":0.545,"earningsQuarterlyGrowth":0.626,"totalRevenue":71776002048,"grossProfits":45906001920,"ebitda":34432999424,"netIncomeToCommon":18736001024,"operatingCashflow":46940000256,"freeCashflow":-45853626368,"totalCash":37077000192,"totalCashPerShare":12.262,"totalDebt":169142992896,"debtToEquity":251.716,"currentRatio":1.171,"quickRatio":1.02,"bookValue":20.444,"revenuePerShare":24.793,"trailingEps":6.38,"forwardEps":11.05881,"epsCurrentYear":8.15047,"epsTrailingTwelveMonths":6.38,"dividendRate":2.0,"dividendYield":1.93,"payoutRatio":0.31350002,"exDividendDate":1791504000,"lastDividendValue":0.5,"lastDividendDate":1791504000,"trailingAnnualDividendRate":2.0,"trailingAnnualDividendYield":0.019252984,"fiveYearAvgDividendYield":1.2,"beta":1.778,"sharesOutstanding":3117708046,"floatShares":1894158942,"impliedSharesOutstanding":3117708046,"sharesShort":52367533,"sharesShortPriorMonth":47521444,"shortRatio":1.28,"shortPercentOfFloat":0.026800001,"sharesPercentSharesOut":0.0168,"dateSho